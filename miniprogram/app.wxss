/**app.wxss**/

page {
  --primary-color: #2e7d32;
  --primary-light: #449448;
  --bg-gradient-start: #e8f5e9;
  --bg-gradient-end: #c8e6c9;
  --text-main: #333333;
  --text-sub: #888888;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}