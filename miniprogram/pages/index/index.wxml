<!-- index.wxml -->
<view class="page-container">

<!-- 1. 右上角悬浮：待办圆形图标 -->
<view class="floating-todo-btn" bindtap="goToPending">
  <!-- 这里用文字模拟图标，可换成 image -->
  <text class="todo-text">待办</text> 
  <!-- 红点角标 (右上角) -->
  <view class="red-dot" wx:if="{{pendingCount > 0}}">{{pendingCount}}</view>
</view>

<view class="logo-area">
  <image 
    src="/images/zhulu-logo.png" 
    mode="aspectFit" 
    class="logo-img"
  ></image>
</view>

<view class="header-group">
    <text class="main-title">查询库存</text>
    <text class="sub-title">快速查询商品库存与价格</text>
  </view>

<!-- 2. 核心搜索卡片 (竖向长方形) -->
<view class="main-card">
  

  <!-- 输入框 (居中) -->
  <view class="input-wrapper">
    <input 
      class="search-input"
      placeholder="输入 KYB/OE号/车型"
      value="{{oeCode}}"
      bindinput="onInput"
      confirm-type="search"
      bindconfirm="handleSearch"
      maxlength="-1"
    />

     <!-- 清除按钮 -->
  <view wx:if="{{oeCode}}" class="clear-btn" catchtap="clearInput">×</view>
  </view>

  <!-- 按钮组 (垂直排列，间距均匀) -->
  <view class="btn-group-vertical">
    <!-- 按钮1：扫一扫 (绿色) -->
    <button class="action-btn btn-primary scan-btn" bindtap="handleScan">
      <image 
    src="/images/icons/scan_icon.png" 
    class="btn-icon-img" 
    mode="aspectFit"
      ></image>
  
      <text>扫码识别</text>
    </button>

    <!-- 按钮2：查询库存 (深绿/强调) -->
    <button class="action-btn btn-highlight search-btn" bindtap="handleSearch">
      <image 
    src="/images/icons/search_icon.png" 
    class="btn-icon-img" 
    mode="aspectFit"
      ></image>
  
      <text>查询库存</text>
    </button>

  </view>

  <!-- 底部提示文字 -->
  <view class="footer-tip">支持型号模糊搜索</view>

</view>

  <!-- 4. 加载状态提示 -->
  <view wx:if="{{loading}}" class="loading-tip">
    <text>正在努力检索数据...</text>
  </view>
<!-- 【新增】多条搜索结果列表 -->
  <view id="resultList" wx:if="{{searchResults && searchResults.length > 0}}" class="result-card">
  <view class="card-header">
    <text class="card-title">找到 {{resultCount}} 条记录，请选择</text>
  </view>
  <view class="divider-line"></view>
  
  <view 
    wx:for="{{searchResults}}" 
    wx:key="_id" 
    class="result-list-item" 
    bindtap="handleSelectResult"
    data-id="{{item._id}}"
  >
    <view class="list-item-main">
      <text class="list-item-kyb">KYB: {{item.kyb_no}}</text>
      <text class="list-item-model">{{item.car_model}}</text>
    </view>
    <view class="list-item-right">
      <text class="list-item-stock {{item.stockStatusListClass || (item.stock > 0 ? 'stock-in' : 'stock-out')}}">库存:{{item.stock}}</text>
      <text class="list-item-direction">方向: {{item.direction}}</text>
    </view>
  </view>
  </view>

  <!-- 5. 结果展示区域-->
  <!-- 只有 productData 有值时才显示整个卡片 -->
  <view id="detailCard" wx:if="{{productData}}" class="result-card">

    <!-- 卡片头部 -->
    <view class="card-header">
      <view class="back-bar" bindtap="backToList">
    <image src="/images/icons/return.png" class="back-icon" mode="aspectFit"></image>
  </view>
      <text class="card-title">库存详情</text>
        <!-- 根据 stock 数值动态切换样式类名 -->
        <text class="status-tag {{productData.stockStatusClass}}">{{productData.stockStatusText}}</text>
    </view>

    <!-- 2. 分割线：贯穿整个卡片宽度 -->
    <view class="divider-line"></view>

    <!-- 卡片内容区 -->
    <view class="item-left">
    <!-- 判断是否有图片，有则显示，无则显示默认占位图 -->
      <scroll-view 
      class="img-scroll-container" 
      scroll-x="{{true}}" 
      wx:if="{{productData.images && productData.images.length > 0}}"
    >
    <!-- 【新增】内部列表容器，用于排列图片 -->
      <view class="img-list">
      <!-- 【修改】使用 wx:for 循环渲染所有图片 -->
       <image 
         wx:for="{{productData.images}}" 
         wx:key="*this" 
         src="{{item}}" 
         mode="aspectFill" 
         class="preview-img"
         bindtap="previewImage"
         data-src="{{item}}" 
       />
      </view>
      </scroll-view>

  <!-- 【保留】没有图片时显示默认占位图 -->
      <image 
       wx:else
        src="../../images/default-product.png" 
        mode="aspectFill" 
        class="preview-img single-img"
      />
    </view>

    <view class="card-body">
      <view class="divider-line"></view>

      <view class="info-row">
        <text class="label">产品编号:</text>
        <text class="value">{{productData._id || '暂无'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">适用车型:</text>
        <text class="value"  selectable="true" user-select="true">{{productData.car_model || '暂无'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">KYB编号:</text>
        <text class="value">{{productData.kyb_no || '暂无'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row oe-container">
        <text class="label">OE编号:</text>
    <!-- value 类名保留，但内容放 item.oe_no -->
        <text class="value oe-grid-text"  selectable="true" user-select="true">{{productData.oe_no}}</text> 
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">适用方向:</text>
        <text class="value">{{productData.direction || '暂无'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">适用年款:</text>
        <text class="value highlight">{{productData.model_year}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">当前库存:</text>
        <text class="value highlight">{{productData.stock}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">库存位置:</text>
        <text class="value">{{productData.location || '未分配'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row">
        <text class="label">参考价格:</text>
        <text class="value price">￥{{productData.price || '0'}}</text>
      </view>
      <view class="divider-line"></view>
      <view class="info-row" >
        <text class="label">备注内容:</text>
  <!-- 使用 text 标签包裹，防止长文本破坏 flex 布局，同时保留换行符 -->
        <text class="value remark-content"  selectable="true" user-select="true">{{productData.remark||'暂无备注'}}</text>
      </view>

      <view class="action-buttons">
      <!-- 编辑按钮：传递 _id -->
       <button 
          class="btn-custom btn-edit" 
          bindtap="goToEdit" 
          data-id="{{productData._id}}"
       >
        <view class="btn-inner">
            <image src="/images/icons/icon_edit.png" class="btn-icon" mode="aspectFit"></image>
            <text class="btn-text">编辑</text>
          </view>
        </button>
    
    <!-- 删除按钮：传递 _id -->
        <button 
          class="btn-custom btn-delete" 
          bindtap="handleDelete" 
         data-id="{{productData._id}}"
        >
          <image src="/images/icons/icon_delete.png" class="btn-icon" mode="aspectFit"></image>
          <text class="btn-text">删除</text>
       </button>
       <!-- 生成二维码按钮 -->
       <button class="btn-custom btn-qrcode" bindtap="showQRCode">
    <image src="/images/icons/business.png" class="btn-icon" mode="aspectFit"></image>
    <text>二维码</text>
  </button>
       <!-- 二维码弹窗 -->
       <view class="qrcode-mask" wx:if="{{showQrcode}}" bindtap="hideQRCode">
       <view class="qrcode-box" catchtap="">
        <image 
        src="{{qrCodeBase64}}" 
        class="qrcode-image" 
        mode="aspectFit"></image>
    <button class="save-btn" bindtap="saveQRCode">保存到相册</button>
    <view class="close-btn" bindtap="hideQRCode">✕</view>
        </view>
      </view>
      </view>
    </view>

    <!-- 6. 底部操作按钮 -->
    <view class="action-buttons">
      <button class="custom-btn btn-in" bindtap="goToInbound" data-item="{{productData}}">入库</button>
      <button class="custom-btn btn-out" bindtap="goToOutbound" data-item="{{productData}}">出库</button>
    </view>

  </view> 
</view>