/* pages/client/search/search.wxss */

page {
  --primary-color: #2e7d32; 
  --primary-light: #4caf50; 
  --bg-gradient-start: #e8f5e9; 
  --bg-gradient-end: #c8e6c9;   
  --text-main: #333333;
  --text-sub: #888888;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
  padding: 20rpx;
  box-sizing: border-box; /* 【重要】防止padding导致页面出现横向滚动条 */
}

/* --- 1. 顶部搜索栏修复 --- */
.search-bar {
  width: 100%; /* 防止在大屏或某些机型上偏左 */
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  padding: 10rpx;
  border-radius: 50rpx;
  box-shadow: 0 4px 12px rgba(46, 125, 50, 0.05);
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.search-input-wrapper {
  flex: 1;
  background-color: #f5f9f5;
  border-radius: 50rpx;
  padding: 0 30rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.search-btn {
  background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
  color: white;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  box-shadow: 0 6px 12px rgba(46, 125, 50, 0.3);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- 2. 结果卡片 --- */
.card {
  width: 90%;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden; /* 【重要】防止内容溢出卡片圆角 */
}

.card-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}

.img {
  width: 100%;
  height: 240rpx;
  display:block;
  background-color: #f0f0f0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 多图横排展示（最多三张） */
.img-list {
  display: flex;
  gap: 16rpx; /* 图片之间的间距 */
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.img-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.img-item:last-child {
  margin-right: 0;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0; /* 【重要】允许文字区域收缩，防止被图片挤压 */
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.car-model {
  font-size: 24rpx;
  color: var(--primary-color);
  background: rgba(46, 125, 50, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* --- 3. 核心修复：使用 Grid 布局替代 Flex --- */
.specs-grid {
  display: grid; /* 【核心】启用网格布局 */
  grid-template-columns: 1fr 1fr; /* 【核心】严格分为两列，每列等宽 */
  column-gap: 20rpx; /* 列间距 */
  row-gap: 24rpx;    /* 行间距 */
  
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
  /* 移除之前的 border-top，如果需要分割线可以用伪元素或保留 padding */
}

.spec-item {
  display: flex;
  flex-direction: column;
  /* 不需要设置 width: 50%，Grid 会自动处理 */
  min-width: 0; /* 允许子元素在 Grid 单元格内收缩 */
}

.spec-item.full-width {
  grid-column: span 2; 
  background-color: #f9fbf9; /* 给车型加个浅色背景突出显示 */
  padding: 10rpx;
  border-radius: 8rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.spec-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all; /* 允许在任意字符间断行 */
  white-space: normal;   /* 允许换行 */
  overflow-wrap: break-word; /* 兼容旧版浏览器 */
}

/* 车型文字特别样式 */
.car-text {
  color: #2e7d32;
  font-weight: 500;
}

.spec-value.highlight {
  color: var(--primary-color);
}

/* --- 4. 底部价格区 --- */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  background: linear-gradient(90deg, #f1f8e9 0%, #fff 100%);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 20rpx; /* 增加一点上间距 */
}

.price-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.price-val {
  font-size: 36rpx;
  font-weight: bold;
  color: #e53935;
}

.empty {
  text-align: center;
  padding-top: 100rpx;
  color: var(--text-sub);
  font-size: 28rpx;
}