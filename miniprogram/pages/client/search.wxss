page {
  min-height: 100%;
  background: #f3f5f3;
}

.search-page {
  display: flex;
  width: 100%;
  min-height: 100vh;
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 24rpx calc(136rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-heading {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.brand-mark {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
}

.heading-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.brand-kicker {
  color: #858f88;
  font-size: 17rpx;
  line-height: 1.25;
}

.page-title {
  margin-top: 5rpx;
  color: #26382d;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.2;
}

.heading-note {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  color: #5d7464;
  font-size: 20rpx;
  background: #e8eee9;
  border-radius: 6rpx;
}

.search-tools {
  display: flex;
  align-items: center;
}

.search-field {
  display: flex;
  min-width: 0;
  height: 86rpx;
  flex: 1;
  align-items: center;
  padding: 0 16rpx 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #dde4de;
  border-radius: 8rpx;
}

.search-glyph {
  position: relative;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  box-sizing: border-box;
  border: 2rpx solid #78847b;
  border-radius: 50%;
}

.search-glyph::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 2rpx;
  background: #78847b;
  content: '';
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: #2e3932;
  font-size: 25rpx;
  line-height: 86rpx;
}

.search-placeholder {
  color: #9aa29c;
  font-size: 24rpx;
}

.clear-button {
  display: flex;
  width: 44rpx;
  height: 48rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: #8b948e;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  background: transparent;
}

.clear-button::after {
  border: 0;
}

.search-button {
  display: flex;
  width: 124rpx;
  height: 86rpx;
  flex: 0 0 124rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  background: #2f6e49;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.search-button[disabled] {
  opacity: 0.72;
}

.search-button::after {
  border: 0;
}

.search-hint {
  display: block;
  margin: 12rpx 2rpx 0;
  color: #818b84;
  font-size: 20rpx;
  line-height: 1.45;
}

.results-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 2rpx 16rpx;
}

.results-title {
  color: #2d3b32;
  font-size: 27rpx;
  font-weight: 650;
}

.results-count {
  color: #7e8981;
  font-size: 21rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
}

.product-result {
  min-width: 0;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e3e8e3;
  border-radius: 8rpx;
  transition: background-color 0.12s ease;
}

.product-result + .product-result {
  margin-top: 14rpx;
}

.result-pressed {
  background: #f8faf8;
}

.result-main {
  display: flex;
  min-width: 0;
  align-items: center;
}

.result-image {
  display: block;
  width: 152rpx;
  height: 152rpx;
  flex: 0 0 152rpx;
  background: #edf0ed;
  border-radius: 6rpx;
}

.result-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 18rpx;
}

.model-name {
  display: -webkit-box;
  width: 100%;
  overflow: hidden;
  color: #28382e;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fitment-line {
  display: flex;
  min-width: 0;
  align-items: center;
  margin-top: 8rpx;
  color: #78837b;
  font-size: 21rpx;
  line-height: 1.35;
}

.fitment-line text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fitment-separator {
  flex: 0 0 auto;
  margin: 0 8rpx;
  color: #b0b8b2;
}

.kyb-number {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #758078;
  font-size: 19rpx;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price-line {
  display: flex;
  min-width: 0;
  align-items: baseline;
  margin-top: auto;
  padding-top: 10rpx;
  color: #b34237;
}

.price-currency {
  flex: 0 0 auto;
  margin-right: 2rpx;
  font-size: 20rpx;
}

.price-value {
  min-width: 0;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price-caption {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: #8a938c;
  font-size: 18rpx;
}

.detail-arrow {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  margin-left: 12rpx;
  border-top: 2rpx solid #a1aaa3;
  border-right: 2rpx solid #a1aaa3;
  transform: rotate(45deg);
}

.oe-section {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0ed;
}

.oe-label {
  flex: 0 0 56rpx;
  padding-top: 5rpx;
  color: #78837b;
  font-size: 19rpx;
  line-height: 1.4;
}

.oe-list {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  align-items: center;
}

.oe-tag,
.oe-more {
  max-width: 100%;
  padding: 5rpx 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 18rpx;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
  border-radius: 4rpx;
}

.oe-tag {
  color: #496b53;
  background: #f0f4f0;
  border: 1rpx solid #e0e8e0;
}

.oe-tag,
.oe-more {
  margin: 0 8rpx 8rpx 0;
}

.oe-more {
  color: #6e7971;
  background: #f5f6f5;
}

.add-cart-button {
  display: flex;
  height: 58rpx;
  margin: 16rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #286644;
  font-size: 21rpx;
  line-height: 1;
  background: #f0f5f1;
  border-radius: 6rpx;
}

.add-cart-button::after {
  border: 0;
}

.state-panel {
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.initial-state {
  min-height: 420rpx;
}

.state-title {
  color: #3b4840;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}

.state-description {
  max-width: 100%;
  margin-top: 8rpx;
  color: #818b84;
  font-size: 21rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.state-indicator {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 22rpx;
  border: 4rpx solid #dce5dd;
  border-top-color: #397b56;
  border-radius: 50%;
  animation: search-spin 0.8s linear infinite;
}

.empty-mark {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #b9c4bc;
  border-radius: 50%;
}

.search-guide-line {
  width: 56rpx;
  height: 4rpx;
  margin-bottom: 22rpx;
  background: #93a69a;
}

@keyframes search-spin {
  to {
    transform: rotate(360deg);
  }
}
