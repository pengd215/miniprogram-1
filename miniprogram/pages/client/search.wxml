<view class="search-page">
  <view class="page-heading">
    <image class="brand-mark" src="/images/zhulu-logo.png" mode="aspectFit" />
    <view class="heading-copy">
      <text class="brand-kicker">ZHULU AUTO PARTS</text>
      <text class="page-title">配件查询</text>
    </view>
    <text class="heading-note">客户报价</text>
  </view>

  <view class="search-tools">
    <view class="search-field">
      <view class="search-glyph" aria-hidden="true"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="输入 OE 号、KYB 号或车型"
        placeholder-class="search-placeholder"
        bindinput="onInput"
        confirm-type="search"
        bindconfirm="doSearch"
        maxlength="80"
      />
      <button wx:if="{{keyword}}" class="clear-button" aria-label="清空关键词" bindtap="clearKeyword">×</button>
    </view>
    <button class="search-button" loading="{{isLoading}}" disabled="{{isLoading}}" bindtap="doSearch">搜索</button>
  </view>
  <text class="search-hint">支持 OE 编号、KYB 编号及车型模糊查询</text>

  <view class="results-heading" wx:if="{{hasSearched && !isLoading && !errorMessage}}">
    <text class="results-title">查询结果</text>
    <text class="results-count">{{results.length}} 项</text>
  </view>

  <view class="result-list" wx:if="{{results.length}}">
    <view
      class="product-result"
      wx:for="{{results}}"
      wx:key="_id"
      bindtap="openDetail"
      data-id="{{item._id}}"
      hover-class="result-pressed"
    >
      <view class="result-main">
        <image
          class="result-image"
          src="{{item.coverImage}}"
          mode="aspectFill"
          lazy-load="true"
          binderror="onImageError"
          catchtap="previewImage"
          data-index="{{index}}"
          data-images="{{item.images}}"
          data-current="{{item.coverImage}}"
        />
        <view class="result-info">
          <text class="model-name">{{item.car_model || '车型信息待补充'}}</text>
          <view class="fitment-line">
            <text>{{item.model_year || '年款不限'}}</text>
            <text class="fitment-separator" wx:if="{{item.direction}}">/</text>
            <text wx:if="{{item.direction}}">{{item.direction}}</text>
          </view>
          <text class="kyb-number" wx:if="{{item.kyb_no}}">KYB {{item.kyb_no}}</text>
          <view class="price-line">
            <text class="price-currency">¥</text>
            <text class="price-value">{{item.price}}</text>
            <text class="price-caption">参考价</text>
          </view>
        </view>
        <view class="detail-arrow" aria-hidden="true"></view>
      </view>

      <view class="oe-section" wx:if="{{item.visibleOeList.length}}">
        <text class="oe-label">OE</text>
        <view class="oe-list">
          <text class="oe-tag" wx:for="{{item.visibleOeList}}" wx:for-item="oe" wx:key="index">{{oe}}</text>
          <text class="oe-more" wx:if="{{item.moreOeCount}}">+{{item.moreOeCount}}</text>
        </view>
      </view>
      <button class="add-cart-button" catchtap="addToCart" data-id="{{item._id}}">加入购物车</button>
    </view>
  </view>

  <view class="state-panel" wx:if="{{isLoading && !results.length}}">
    <view class="state-indicator"></view>
    <text class="state-title">正在查询</text>
    <text class="state-description">请稍候</text>
  </view>
  <view class="state-panel" wx:elif="{{errorMessage}}">
    <text class="state-title">查询暂不可用</text>
    <text class="state-description">{{errorMessage}}</text>
  </view>
  <view class="state-panel" wx:elif="{{hasSearched && !results.length}}">
    <view class="empty-mark"></view>
    <text class="state-title">没有找到匹配配件</text>
    <text class="state-description">请核对编号，或尝试车型关键词</text>
  </view>
  <view class="state-panel initial-state" wx:elif="{{!hasSearched}}">
    <view class="search-guide-line"></view>
    <text class="state-title">输入配件信息开始查询</text>
    <text class="state-description">支持 OE 编号、KYB 编号或车型</text>
  </view>

  <client-tabbar id="client-tabbar" active="search" />
</view>
