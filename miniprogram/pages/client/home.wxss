page {
  background: #f4f6f4;
}

.home-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(136rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.home-header {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 184rpx;
  padding: 22rpx 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 8rpx;
}

.brand-logo {
  width: 132rpx;
  max-height: 132rpx;
  margin-right: 22rpx;
}

.header-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.eyebrow {
  color: #8b948e;
  font-size: 18rpx;
  line-height: 1.4;
}

.page-title {
  margin-top: 8rpx;
  color: #243b2e;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #717b74;
  font-size: 22rpx;
}

.header-rule {
  position: absolute;
  top: 0;
  right: 0;
  width: 8rpx;
  height: 100%;
  background: #397b56;
}

.catalog-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 20rpx;
}

.section-title {
  color: #26372d;
  font-size: 30rpx;
  font-weight: 650;
}

.section-count {
  color: #78827b;
  font-size: 22rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.product-card {
  min-width: 0;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e5e9e5;
  border-radius: 8rpx;
}

.product-image {
  display: block;
  width: 100%;
  height: 320rpx;
  background: #edf0ed;
}

.product-info {
  padding: 18rpx 16rpx 20rpx;
}

.product-model {
  display: -webkit-box;
  overflow: hidden;
  color: #2d3931;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-meta {
  display: block;
  min-height: 34rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #78827b;
  font-size: 21rpx;
  line-height: 1.5;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-top: 14rpx;
  color: #b23a32;
}

.currency {
  flex: 0 0 auto;
  font-size: 21rpx;
}

.product-price {
  min-width: 0;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price-unit {
  flex: 0 0 auto;
  margin-left: auto;
  padding-left: 8rpx;
  color: #8a928c;
  font-size: 18rpx;
}

.add-cart-button {
  display: flex;
  height: 58rpx;
  margin: 16rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #286644;
  font-size: 21rpx;
  line-height: 1;
  background: #f0f5f1;
  border-radius: 6rpx;
}

.add-cart-button::after {
  border: 0;
}

.state-block {
  display: flex;
  min-height: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #717b74;
}

.state-title {
  font-size: 26rpx;
}

.retry-button {
  margin-top: 24rpx;
  padding: 0 32rpx;
  color: #246b45;
  font-size: 24rpx;
  line-height: 64rpx;
  background: #ffffff;
  border: 1rpx solid #b9c9bd;
  border-radius: 6rpx;
}

.retry-button::after {
  border: 0;
}

.load-more {
  margin: 24rpx auto 0;
  padding: 0 30rpx;
  color: #246b45;
  font-size: 23rpx;
  line-height: 62rpx;
  background: #ffffff;
  border: 1rpx solid #cbd8ce;
  border-radius: 6rpx;
}

.load-more::after {
  border: 0;
}

.loading-row,
.end-row {
  padding: 28rpx 0 14rpx;
  color: #89918b;
  font-size: 21rpx;
  text-align: center;
}
