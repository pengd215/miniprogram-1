/* pages/inbound/inbound.wxss */

page {
  background-color: #f7f8fa;
  min-height: 100vh;
}
/* pages/inbound/inbound.wxss */

/* 修改这里的 .container */
.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center; /* 保持水平居中 */
  
  /* --- 核心修改开始 --- */
  min-height: 100vh;   /* 1. 强制容器高度至少占满整个屏幕 */
  box-sizing: border-box; /* 2. 确保 padding 不会导致溢出出现滚动条 */
  justify-content: space-between; /* 3. 【关键】让第一个子元素（标题/卡片）在顶部，最后一个子元素（按钮）在底部 */
  /* --- 核心修改结束 --- */
}

/* 建议：为了确保按钮在最底部，建议在 WXML 中给底部的按钮区域加一个 wrapper，或者确保它是 container 的最后一个直接子元素 */
.footer-action {
  width: 100%;
  margin-top: auto; /* 双重保险：利用 margin-auto 将按钮推到底部 */
  padding-bottom: 40rpx; /* 适配全面屏底部安全区 */
  display: flex;
  justify-content: center; /* 确保按钮本身在横向上也是居中的 */
}


.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

/* --- 卡片区域 --- */
.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

/* --- 核心修复：输入框行布局 (Flex) --- */
.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx; /* 输入框与按钮间距 */
}

/* 输入框通用样式 */
.full-input {
  flex: 1; /* 占据剩余空间 */
  height: 88rpx;
  line-height: 88rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.full-textarea {
  width: 100%;
  height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.placeholder-style {
  color: #ccc;
}
/* 扫一扫按钮 - 强制修正版 */
.scan-btn {
  /* 1. 强制固定尺寸，防止被内容撑开或默认样式影响 */
  width: 160rpx !important; 
  height: 88rpx !important;
  line-height: 86rpx !important; /* 微调行高以垂直居中文字 */
  min-width: 160rpx !important; /* 关键：覆盖微信按钮默认的最小宽度 */
  
  /* 2. 清除默认内边距，让尺寸更精准 */
  padding: 0 !important; 
  margin: 0;
  
  /* 3. 保持与出库一致的视觉风格 */
  background: linear-gradient(135deg, #07c160, #05a550);
  color: white !important;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  
  /* 4. Flex布局确保文字/图标居中 */
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 去除按钮默认边框 */
.scan-btn::after {
  border: none !important;
}



/* --- 核心修复：底部确认按钮区域 --- */
.footer-action {
  margin-top: auto; /* 推到底部 */
  padding-bottom: 40rpx; /* 适配全面屏 */
}

.confirm-btn {
  width: 100% !important; /* 通栏宽度 */
  height: 96rpx !important;
  line-height: 96rpx !important;
  
  /* 这里的颜色改为入库绿，结构与出库一致 */
  background: linear-gradient(135deg, #07c160, #06ad56) !important;
  color: white !important;
  font-size: 34rpx !important;
  font-weight: bold;
  
  border-radius: 48rpx !important; /* 大圆角 */
  box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.3); /* 绿色投影 */
  
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn::after {
  border: none !important;
}