<!-- pages/inbound/inbound.wxml -->
<view class="container">
  <view class="header-title">采购入库单</view>

  <view class="form-card">
    <!-- OE码行 -->
    <view class="form-item">
      <view class="label">减震器编号 / OE码</view>
      <view class="input-row">
        <input 
          class="full-input" 
          placeholder="请输入或扫描 OE 编码" 
          value="{{oeCode}}"
          bindinput="onOeCodeInput" 
          placeholder-class="placeholder-style"
        />
        <button class="scan-btn" bindtap="onScanCode">扫一扫</button>
      </view>
    </view>

    <!-- 数量行 -->
    <view class="form-item">
      <view class="label">入库数量</view>
      <input 
        class="full-input" 
        type="number" 
        placeholder="请输入入库数量" 
        value="{{quantity}}"
        bindinput="onQuantityInput"
        placeholder-class="placeholder-style"
      />
    </view>

    <!-- 备注行 -->
    <view class="form-item">
      <view class="label">备注信息</view>
      <textarea 
        class="full-textarea" 
        placeholder="选填，如：供应商名称" 
        placeholder-class="placeholder-style"
        bindinput="onRemarkInput"
        value="{{remark}}"
      ></textarea>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-action">
    <button class="confirm-btn" bindtap="confirmInbound">确认入库</button>
  </view>
</view>