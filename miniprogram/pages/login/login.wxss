/* pages/login/login.wxss  */

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding: 96rpx 64rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* ===== 背景动画层 ===== */
.bg-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.ring {
  position: absolute;
  border-radius: 50%;
  border: 3rpx dashed rgba(46, 125, 50, 0.32);
}

.ring-a {
  width: 620rpx;
  height: 620rpx;
  top: -200rpx;
  right: -240rpx;
  animation: spin-slow 70s linear infinite;
}

.ring-b {
  width: 460rpx;
  height: 460rpx;
  top: -120rpx;
  right: -160rpx;
  border-color: rgba(46, 125, 50, 0.22);
  animation: spin-slow 50s linear infinite reverse;
}

.bubble {
  position: absolute;
  bottom: -80rpx;
  border-radius: 50%;
  background: rgba(68, 148, 72, 0.12);
  animation: rise 14s linear infinite;
}

.bubble-1 {
  left: 10%;
  width: 44rpx;
  height: 44rpx;
  animation-duration: 13s;
}

.bubble-2 {
  left: 36%;
  width: 26rpx;
  height: 26rpx;
  background: rgba(68, 148, 72, 0.16);
  animation-duration: 17s;
  animation-delay: 3s;
}

.bubble-3 {
  left: 62%;
  width: 56rpx;
  height: 56rpx;
  background: rgba(68, 148, 72, 0.09);
  animation-duration: 15s;
  animation-delay: 6s;
}

.bubble-4 {
  left: 84%;
  width: 32rpx;
  height: 32rpx;
  animation-duration: 19s;
  animation-delay: 1.5s;
}

.logo-image {
  width: 32%;
  height: 22rpx;
  display: block;
  mix-blend-mode: multiply;
  margin-bottom: 10rpx;
}

/* ===== 顶部标识 + 问候语 ===== */
.header {
  position: relative;
  z-index: 1;
  animation: fade-up 0.6s ease both;
}
.logo-box{
  display:flex; 
}


.greeting {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
}

.hi {
  font-size: 56rpx;
  font-weight: bold;
  color: #1f2329;
  letter-spacing: 2rpx;
}

.welcome {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2329;
  letter-spacing: 1rpx;
}

.tip {
  display: block;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #9aa2ad;
  letter-spacing: 1rpx;
}

/* ===== 表单区 ===== */
.form-area {
  position: relative;
  z-index: 1;
  margin-top: 64rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  animation: fade-up 0.6s 0.15s ease both;
}

.input-group {
  height: 100rpx;
  box-sizing: border-box;
  background: #eef0f3;
  border-radius: 50rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.input-group:focus-within {
  background: #ffffff;
  border-color: #2e7d32;
}

.input-field {
  flex: 1;
  height: 48rpx;
  font-size: 30rpx;
  color: #1f2329;
}

.placeholder-style {
  color: #b6bcc6;
  font-size: 28rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  position: relative;
  z-index: 2;
  margin-top: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  border: none;
  border-radius: 50rpx;
  background: linear-gradient(90deg, #2e7d32, #449448);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  animation: btn-glow 2.6s ease-in-out infinite;
}

.login-btn:active {
  opacity: 0.88;
  transform: scale(0.985);
}

/* ===== 底部提示 ===== */
.footer-text {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6bcc6;
  letter-spacing: 2rpx;
}

/* ===== 底部插画 ===== */
.illustration {
  margin-left: -32rpx;
  margin-right: -32rpx;
  padding-top: 5rpx;
  animation: float-slow 6s ease-in-out infinite;
}

.illu-image {
  width: 100%;
  display: block;
}

/* ===== 动效 ===== */
@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float-slow {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14rpx);
  }
}

@keyframes spin-slow {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes rise {
  0% {
    transform: translateY(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  85% {
    opacity: 1;
  }
  100% {
    transform: translateY(-130vh);
    opacity: 0;
  }
}

@keyframes btn-glow {
  0%,
  100% {
    box-shadow: 0 12rpx 28rpx rgba(46, 125, 50, 0.28);
  }
  50% {
    box-shadow: 0 12rpx 44rpx rgba(46, 125, 50, 0.5);
  }
}