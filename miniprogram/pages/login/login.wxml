<!-- pages/login/login.wxml -->
<view class="login-container">
  <!-- 顶部 Logo 区域 -->
  <view class="header">
    <view class="logo-box">
      <!-- 一个简单的箱子/库存图标 SVG -->
      <svg width="60" height="60" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
        <path d="M853.333333 298.666667L512 128 170.666667 298.666667v426.666666L512 896l341.333333-170.666667V298.666667z m-64 387.413333L512 824.746667 234.666667 686.08V337.92L512 199.253333l277.333333 138.666667v348.16z" fill="#ffffff"></path>
        <path d="M512 554.666667l-170.666667-85.333334v-56.96L512 497.706667l170.666667-85.333334v56.96L512 554.666667z" fill="#ffffff"></path>
        <path d="M512 725.333333l-170.666667-85.333333v-56.96L512 668.373333l170.666667-85.333333v56.96L512 725.333333z" fill="#ffffff"></path>
      </svg>
    </view>
    <text class="title">减震器库存系统</text>
    <text class="subtitle">专业 · 高效 · 安全</text>
  </view>

  <!-- 表单卡片区域 -->
  <view class="form-card">
    <!-- 用户名输入 -->
    <view class="input-group">
      <view class="icon-user">
         <svg width="20" height="20" viewBox="0 0 1024 1024"><path d="M512 512c113.6 0 204.8-91.2 204.8-204.8S625.6 102.4 512 102.4 307.2 193.6 307.2 307.2 398.4 512 512 512z m0 102.4c-136.533333 0-409.6 68.266667-409.6 204.8v102.4h819.2v-102.4c0-136.533333-273.066667-204.8-409.6-204.8z" fill="#2e7d32"></path></svg>
      </view>
      <input 
        class="input-field" 
        type="text" 
        placeholder="请输入工号/用户名" 
        placeholder-class="placeholder-style"
        bindinput="onInputUser"
      />
    </view>

    <!-- 密码输入 -->
    <view class="input-group">
      <view class="icon-lock">
        <svg width="20" height="20" viewBox="0 0 1024 1024"><path d="M768 384V320c0-141.44-114.56-256-256-256S256 178.56 256 320v64c-70.4 0-128 57.6-128 128v384c0 70.4 57.6 128 128 128h512c70.4 0 128-57.6 128-128V512c0-70.4-57.6-128-128-128z m-426.666667-64c0-94.08 76.586667-170.666667 170.666667-170.666667s170.666667 76.586667 170.666667 170.666667v64H341.333333v-64z" fill="#2e7d32"></path></svg>
      </view>
      <input 
        class="input-field" 
        password 
        placeholder="请输入密码" 
        placeholder-class="placeholder-style"
        bindinput="onInputPass"
      />
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="handleLogin">
      立即登录
    </button>
    
    <view class="footer-text">
      内部系统 · 请勿外传
    </view>
  </view>
</view>