<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 背景动画层（位于内容之下） -->
  <view class="bg-deco">
    <view class="ring ring-a"></view>
    <view class="ring ring-b"></view>
    <view class="bubble bubble-1"></view>
    <view class="bubble bubble-2"></view>
    <view class="bubble bubble-3"></view>
    <view class="bubble bubble-4"></view>
  </view>

  <view class="logo-box">
      <image src="/images/zhulu-logo.png" mode="widthFix" class="logo-image"></image>
    </view>

  <!-- 顶部标识 + 问候语 -->
  <view class="header">
    <view class="greeting">
      <text class="hi">你好，</text>
      <text class="welcome">欢迎使用「减振器库存系统」</text>
    </view>
    <text class="tip">登录账号，即可开始使用</text>
  </view>

  <!-- 表单区 -->
  <view class="form-area">
    <view class="input-group">
      <input
        class="input-field"
        type="text"
        placeholder="请输入工号/用户名"
        placeholder-class="placeholder-style"
        bindinput="onInputUser"
      />
    </view>

    <view class="input-group">
      <input
        class="input-field"
        password
        placeholder="请输入密码"
        placeholder-class="placeholder-style"
        bindinput="onInputPass"
      />
    </view>

    <button class="login-btn" bindtap="handleLogin">立即登录</button>

    <view class="footer-text">内部系统 · 请勿外传</view>

    <!-- 底部插画 -->
    <view class="illustration">
      <image src="/images/login-illustration.svg" mode="widthFix" class="illu-image"></image>
    </view>
  </view>
</view>
