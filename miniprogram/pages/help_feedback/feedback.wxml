<!--pages/help_feedback/feedback.wxml-->
<view class="container">
  <!-- 顶部提示 -->
  <view class="tips-card">
    <text>您的每一条建议都是我们改进的动力！我们会认真阅读您的反馈。</text>
  </view>

  <!-- 反馈类型 -->
  <view class="form-item">
    <view class="label">反馈类型</view>
    <radio-group bindchange="onTypeChange">
      <label class="radio-item" wx:for="{{types}}" wx:key="index">
        <radio value="{{item}}" checked="{{index === 0}}" color="#07c160"/>
        <text>{{item}}</text>
      </label>
    </radio-group>
  </view>

  <!-- 问题描述 -->
  <view class="form-item">
    <view class="label">问题描述 <text class="required">*</text></view>
    <textarea 
      class="input-area" 
      placeholder="请详细描述您遇到的问题或建议..." 
      bindinput="onDescInput"
      maxlength="500"
    ></textarea>
    <view class="count">{{descLen}}/500</view>
  </view>

  <!-- 图片上传 -->
  <view class="form-item">
    <view class="label">相关截图 (选填)</view>
    <view class="image-list">
      <view 
      class="image-item" 
      wx:for="{{images}}" 
      wx:key="index"
      >
        <image 
        src="{{item}}" 
        mode="aspectFill" 
        bindtap="previewImage" 
        data-index="{{index}}"
        ></image>
        <view 
        class="delete-btn" 
        bindtap="deleteImage" 
        data-index="{{index}}"
        >×</view>
      </view>
      
      <!-- 上传按钮 -->
      <view class="upload-btn" 
      bindtap="chooseMedia" 
      wx:if="{{images.length < 3}}"
      >
        <text class="icon">+</text>
        <text>添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="submitFeedback" disabled="{{submitting}}">
    {{submitting ? '提交中...' : '提交反馈'}}
  </button>
</view>