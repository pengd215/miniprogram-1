/* pages/help_feedback/feedback.wxss */
.container { 
  padding: 30rpx; 
  background-color: #f8f8f8; 
  min-height: 100vh; 
}

.tips-card { 
  background: #e8f7ed; 
  padding: 20rpx; 
  border-radius: 12rpx;
   font-size: 26rpx; 
   color: #07c160; 
   margin-bottom: 30rpx; 
  }

.form-item { 
  width: 100%;
  background: #fff; 
  padding: 30rpx; 
  border-radius: 16rpx; 
  margin-bottom: 24rpx;
 }
.label { font-size: 30rpx; 
  font-weight: bold; 
  margin-bottom: 20rpx; 
  display: flex; 
  align-items: center;
 }
.required { 
  color: red;
   margin-left: 8rpx;
    font-size: 36rpx;
   }

/* 单选样式 */
.radio-item { 
  display: inline-flex; 
  align-items: center;
   margin-right: 40rpx; 
   margin-bottom: 10rpx; 
  }
.radio-item text { 
  margin-left: 10rpx; 
  font-size: 28rpx; 
}

/* 输入框样式 */
.input-area { 
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee; 
  padding: 20rpx; 
  box-sizing: border-box; 
  border-radius: 8rpx; 
  background: #fafafa;
}
.count { 
  text-align: right;
  font-size: 24rpx; 
  color: #999; 
  margin-top: 10rpx; 
  }
.input-field { width: 100%; font-size: 28rpx; border-bottom: 1rpx solid #eee; padding-bottom: 10rpx; }

/* 图片上传样式 */
.image-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.image-item, .upload-btn { width: 200rpx; height: 200rpx; position: relative; border-radius: 8rpx; overflow: hidden; }
.image-item image { width: 100%; height: 100%; }
.delete-btn { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.6); color: #fff; text-align: center; line-height: 36rpx; font-size: 30rpx; }
.upload-btn { border: 2rpx dashed #ccc; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; background: #fff; }
.upload-btn .icon { font-size: 60rpx; line-height: 60rpx; }
.upload-btn text:last-child { font-size: 24rpx; margin-top: 10rpx; }

/* 提交按钮 */
.submit-btn { background-color: #07c160; color: #fff; border-radius: 50rpx; margin-top: 40rpx; font-size: 32rpx; padding: 20rpx 0; }
.submit-btn[disabled] { background-color: #ccc !important; }