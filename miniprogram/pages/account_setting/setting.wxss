/* account-settings.wxss */
page {
  background-color: #f5f7fa; /* 浅灰背景 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.container {
  padding: 0;
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* --- 头部卡片 --- */
.header-card {
  width: 90%;
  background: linear-gradient(135deg, #1a5c48, #2e8b72); /* 深绿渐变 */
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 92, 72, 0.2);
  position: relative;
  overflow: hidden;
}

.card-content {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-right: 30rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background-color: #eee;
}

.camera-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  background: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.sub-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.tip-bar {
  background: rgba(255, 255, 255, 0.15);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.icon {
  margin-right: 10rpx;
  font-size: 24rpx;
}

.tip-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

/* --- 标题与表单 --- */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.form-group {
  width: 90%;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
}

.icon-box {
  width: 50rpx;
  height: 50rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 24rpx;
}

.name-icon { background: #eef6ff; color: #2d8cf0; }
.gender-icon { background: #fdf2f5; color: #ed4014; }

.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.input {
  text-align: right;
  font-size: 28rpx;
  color: #333;
  width: 400rpx;
}

.picker-value {
  display: flex;
  align-items: center;
}

.value-text { color: #333; font-size: 28rpx; margin-right: 10rpx; }
.placeholder { color: #999; font-size: 28rpx; margin-right: 10rpx; }
.arrow { color: #ccc; font-size: 24rpx; }

/* --- 个人简介 --- */
.textarea-group {
  width: 85%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.bio-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
}

.footer-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.usage-tip { font-size: 24rpx; color: #999; }
.count { font-size: 24rpx; color: #ccc; }

/* --- 底部按钮 --- */
.bottom-btn-area {
  padding: 0 20rpx;
}

.save-btn {
  background: #2e8b72; /* 按钮颜色 */
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(46, 139, 114, 0.3);
}

.btn-icon { margin-right: 10rpx; font-size: 28rpx; }