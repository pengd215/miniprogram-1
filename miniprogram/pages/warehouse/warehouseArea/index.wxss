/*pages/warehouse/warehouseArea/index.wxml*/
/* 全局容器 */
.container {
  padding: 32rpx 24rpx;
  background: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部标题栏 */
.header {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 0 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 新增按钮 */
.add-btn {
  background: #2e7d32;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.add-btn:active {
  background: #1b5e20;
}

/* 库区卡片 */
.warehouse-card {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.1s ease;
}

.warehouse-card:active {
  transform: scale(0.98);
}

/* 卡片主内容区（可点击） */
.card-main {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 库区编码标签 */
.code-badge {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 24rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 库区信息区 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.desc {
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧箭头 */
.arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 卡片底部操作区 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #bbb;
}

.delete-link {
  font-size: 24rpx;
  color: #e64340;
  padding: 4rpx 12rpx;
}

.delete-link:active {
  color: #c62828;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* 弹窗遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 弹窗内容 */
.dialog {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 弹窗输入框 */
.dlg-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.dlg-input:focus {
  border-color: #2e7d32;
}

/* 弹窗按钮组 */
.dialog-btns {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-cancel:active {
  background: #e0e0e0;
}

.btn-ok {
  background: #2e7d32;
  color: #fff;
}

.btn-ok:active {
  background: #1b5e20;
}