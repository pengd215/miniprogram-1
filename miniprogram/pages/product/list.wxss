/* pages/product/list.wxss */
page {
  background-color: #f7f8fa;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* --- 顶部搜索栏 --- */
.search-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;/* 上下左右留白 */
  justify-content: space-between;/* 让输入框和按钮分开 */
  display: flex;
  align-items: center;

  width: 100%; 
  box-sizing: border-box; /* 确保 padding 不会撑破 100% 的宽度 */

  position: sticky; /* 吸顶效果 */
  top: 0;
  z-index: 100;
}
/* 输入框容器：设置 flex:1 让它自动拉长 */
.search-input-box {
  flex: 1;                /* ✅ 关键：占据除按钮外的所有剩余空间 */
  display: flex;
  align-items: center;
  background-color: #f5f5f5; /* 浅灰底色 */
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 70rpx;          /* 高度与按钮保持一致 */
  margin-right: 20rpx;    /* 输入框和按钮之间的间距 */
}

.icon-search {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #333;
}
/* 搜索按钮：固定宽度，不再被挤压 */
.btn-search {
  background-color: #3b6cb5; 
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  width: 140rpx !important;
  height: 70rpx;
  line-height: 70rpx;

  margin: 0;
  padding: 0 ;
  border: none;

  display: flex;
  justify-content: center;
  align-items: center;
}
.btn-search::after {
  border: none; /* 去除小程序按钮默认边框 */
}

/* --- 库存状态筛选栏 --- */
.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 10rpx 20rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
  position: sticky; /* 吸顶，紧贴搜索栏下方 */
  top: 110rpx;
  z-index: 99;
}
.filter-item {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}
.filter-item.active {
  background-color: #3b6cb5;
  color: #fff;
  font-weight: bold;
}

/* --- 列表区域 (非卡片，行列表格) --- */
.list-container {
  width: 100%; 
  background-color: #fff;
  padding-top: 20rpx;
}

.list-row {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f3efef; /* 分割线 */
  background-color: #eceaea;
  min-height: 100rpx;
  box-sizing: border-box;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;/* 圆角 */
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  justify-content: space-between;/* 水平方向两端对齐，撑开宽度 */
  overflow: hidden; /* 内容再长也不超出卡片圆角 */
}

.list-row:active {
  background-color: #f9f9f9; /* 点击反馈 */
}

/* 列宽控制 */
.col-kyb {
  width: 120rpx; /* KYB号固定宽 */
  flex-shrink: 0; /* 防止被压缩 */
  word-break: break-all;
  margin-right: 10rpx; /* 稍微留点缝隙给车型 */
}
.kyb-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  word-break: break-all;
}

.col-car {
  flex: 1; /* 车型占据中间剩余空间 */
  min-width: 0; /* 允许内容在 flex 中被压缩换行 */
  margin-right: 10rpx;
}
.car-text {
  font-size: 28rpx;
  color: #666;
  word-break: break-all; /* 长车型代码自动换行，不再撑破卡片 */
  overflow-wrap: break-word;
  line-height: 1.5;
}

.col-stock {
  min-width: 60rpx; /* 数量列：按内容自适应，最少留 60rpx */
  text-align: right;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.count {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 状态标签样式 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid transparent;
  flex-shrink: 0; /* 标签不被压缩 */
  white-space: nowrap;
}

/* 动态颜色类 */
.status-out {
  background-color: #ffebeb;
  color: #942626; /* 红色：缺货/低库存 */
}
.status-low {
  background-color: #fff7e6;
  color: #a37224; /* 橙色：库存紧张 */
}
.status-normal {
  background-color: #e8f7f0;
  color: #17693f; /* 绿色：充足 */
}
/* 兜底：历史数据若返回 status-in 类名，同样显示绿色背景 */
.status-in {
  background-color: #e8f7f0;
  color: #17693f;
}

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}
.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* --- 列表底部加载提示 --- */
.list-footer {
  text-align: center;
  padding: 30rpx 0 40rpx;
}
.footer-text {
  font-size: 24rpx;
  color: #999;
}

/* --- 悬浮按钮 --- */
.fab_btn {
  position: fixed;
  bottom: 100rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 150, 255, 0.4);
}
.plus-icon {
  color: #fff;
  font-size: 60rpx;
  margin-top: -5rpx;
}

/* --- 产品详情弹窗（仅展示） --- */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end; /* 面板从底部弹出 */
}

.detail-panel {
  width: 100%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.detail-close {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx; /* 扩大点击热区 */
  box-sizing: content-box;
}

.detail-body {
  flex: 1;
  max-height: calc(80vh - 100rpx);
  padding: 10rpx 30rpx 40rpx;
  box-sizing: border-box;
}

/* 产品图片区 */
.detail-images {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}

.detail-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background-color: #f5f5f5;
}

/* 字段行 */
.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}

.detail-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.5;
}

/* 车型字段：强制自动换行，超长车型不撑破弹窗布局 */
.car-model-value {
  min-width: 0;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: normal;
}

/* OE号：固定格位网格，一行最多 3 个，单个 OE 号整体占一格不分裂 */
.oe-row {
  align-items: flex-start;
}

.oe-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
}

.oe-item {
  width: calc((100% - 24rpx) / 3); /* 一行固定 3 格 */
  box-sizing: border-box;
  font-size: 24rpx;
  color: #333;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  padding: 10rpx 8rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  white-space: nowrap; /* 单个 OE 号内部不换行，不分裂 */
  overflow: hidden;
  text-overflow: ellipsis; /* 极长时省略，仍保持完整一格 */
  text-align: center;
}

.oe-item:nth-child(3n) {
  margin-right: 0; /* 每行第 3 个去掉右间距，保证对齐 */
}

/* 库存数值 + 状态标签同行展示 */
.detail-stock {
  flex: 1;
  display: flex;
  align-items: center;
}

.detail-stock .detail-value {
  flex: none;
  margin-right: 16rpx;
}
