/* pages/product/list.wxss */
page {
  background-color: #f7f8fa;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* --- 顶部搜索栏 --- */
.search-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;/* 上下左右留白 */
  justify-content: space-between;/* 让输入框和按钮分开 */
  display: flex;
  align-items: center;

  width: 100%; 
  box-sizing: border-box; /* 确保 padding 不会撑破 100% 的宽度 */

  position: sticky; /* 吸顶效果 */
  top: 0;
  z-index: 100;
}
/* 输入框容器：设置 flex:1 让它自动拉长 */
.search-input-box {
  flex: 1;                /* ✅ 关键：占据除按钮外的所有剩余空间 */
  display: flex;
  align-items: center;
  background-color: #f5f5f5; /* 浅灰底色 */
  border-radius: 32rpx;
  padding: 0 20rpx;
  height: 70rpx;          /* 高度与按钮保持一致 */
  margin-right: 20rpx;    /* 输入框和按钮之间的间距 */
}

.icon-search {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #333;
}
/* 搜索按钮：固定宽度，不再被挤压 */
.btn-search {
  background-color: #3b6cb5; 
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  width: 140rpx !important;
  height: 70rpx;
  line-height: 70rpx;

  margin: 0;
  padding: 0 ;
  border: none;

  display: flex;
  justify-content: center;
  align-items: center;
}
.btn-search::after {
  border: none; /* 去除小程序按钮默认边框 */
}

/* --- 列表区域 (非卡片，行列表格) --- */
.list-container {
  flex: 1;
  width: 100%; 
  overflow-y: auto;
  background-color: #fff;
  padding-top: 20rpx;
}

.list-row {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f3efef; /* 分割线 */
  background-color: #eceaea;
  min-height: 100rpx;
  box-sizing: border-box;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;/* 圆角 */
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  justify-content: space-between;/* 水平方向两端对齐，撑开宽度 */
}

.list-row:active {
  background-color: #f9f9f9; /* 点击反馈 */
}

/* 列宽控制 */
.col-kyb {
  width: 120rpx; /* KYB号固定宽 */
  flex-shrink: 0; /* 防止被压缩 */
  word-break: break-all;
  margin-right: 10rpx; /* 稍微留点缝隙给车型 */
}
.kyb-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.col-car {
  flex: 1; /* 车型占据中间剩余空间 */
  min-width: 0; /* 允许内容在 flex 中换行或截断 */
  margin-right: 10rpx;
}
.car-text {
  font-size: 28rpx;
  color: #666;
}

.col-stock {
  width: 100rpx; /* 数量固定宽 */
  text-align: right;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.stock-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.col-status {
  width: 150rpx; /* 状态标签固定宽 */
  text-align: right;
  flex-shrink: 0;
}

/* 状态标签样式 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid transparent;
}

/* 动态颜色类 */
.status-out {
  background-color: #ffebeb;
  color: #942626; /* 红色：缺货/低库存 */
}
.status-low {
  background-color: #fff7e6;
  color: #a37224; /* 橙色：库存紧张 */
}
.status-normal {
  background-color: #e8f7f0;
  color: #17693f; /* 绿色：充足 */
}

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}
.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* --- 悬浮按钮 --- */
.fab-btn {
  position: fixed;
  bottom: 100rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 150, 255, 0.4);
}
.plus-icon {
  color: #fff;
  font-size: 60rpx;
  margin-top: -5rpx;
}