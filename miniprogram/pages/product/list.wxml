<!--pages/product/list.wxml-->
<view class="container">
<!-- 顶部搜索栏 -->
<view class="search-bar">
  <view class="search-input-box">
    <text class="icon-search">🔍</text>
    <input class="input" 
    placeholder="请输入KYB号或车型" 
    bindinput="onInputChange"
    confirm-type="search"
    bindconfirm="onSearch"
     />
  </view>

  <button class="btn-search" bindtap="onSearch">搜索</button>
</view>

<!-- 库存状态筛选栏 -->
<view class="filter-bar">
  <view class="filter-item {{statusFilter === '' ? 'active' : ''}}" bindtap="onFilterChange" data-status="">全部</view>
  <view class="filter-item {{statusFilter === 'out' ? 'active' : ''}}" bindtap="onFilterChange" data-status="out">缺货</view>
  <view class="filter-item {{statusFilter === 'low' ? 'active' : ''}}" bindtap="onFilterChange" data-status="low">紧张</view>
  <view class="filter-item {{statusFilter === 'normal' ? 'active' : ''}}" bindtap="onFilterChange" data-status="normal">充足</view>
</view>

<!-- 列表区域 -->
<view class="list-container">
  <block wx:if="{{productList.length > 0}}">
    <!-- 点击列表项触发弹窗 -->
    <view class="list-row" wx:for="{{productList}}" wx:key="_id" bindtap="onShowDetail" data-item="{{item}}">
      
      <!-- 1. KYB号 -->
      <view class="col-kyb">
        <text class="kyb-text">{{item.kyb_no}}</text>
      </view>

      <!-- 2. 车型 -->
      <view class="col-car">
        <text class="car-text">{{item.car_model}}</text>
      </view>

      <!-- 3. 剩余库存 -->
      <view class="col-stock">
        <text class="count">{{item.stockCount}}</text>
      </view>

       <!-- 显示状态标签  -->
      <view class="status-tag {{item.statusClass}}">
        {{item.statusText}}
      </view>

    </view>
  </block>

  <!-- 空状态提示 -->
  <view wx:else class="empty-state">
    <image src="/images/404.png" class="empty-img" mode="aspectFit"></image> <!-- 请替换为你的空状态图片路径 -->
    <text class="empty-title">没有找到相关商品</text>
    <text class="empty-desc">试试调整关键词或筛选条件；新配件请先建档。</text>
  </view>

  <!-- 列表底部加载提示 -->
  <view class="list-footer" wx:if="{{productList.length > 0}}">
    <text class="footer-text">{{hasMore ? '下拉到底部加载更多' : '已经全部加载完成'}}</text>
  </view>
</view>

</view>
