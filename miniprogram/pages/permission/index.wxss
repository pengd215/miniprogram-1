/* pages/employee/permission/index.wxss */
.container {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部标题 */
.header {
  margin-bottom: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 员工卡片 */
.emp-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.card-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.avatar-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.username {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
.role-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.role-badge.admin { background: #ffebee; color: #d32f2f; }
.role-badge.warehouse_manager { background: #e8f5e9; color: #2e7d32; }
.role-badge.sales { background: #e3f2fd; color: #1565c0; }
.role-badge.worker { background: #f3e5f5; color: #7b1fa2; }
.role-badge.customer { background: #fff3e0; color: #e65100; }
.arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding-top: 120rpx;
  color: #999;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  color: #666;
}
.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaa;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}
.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}
.dialog-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
.role-picker {
  margin: 32rpx 0;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
}
.picker-value {
  font-size: 28rpx;
  color: #2e7d32;
}
.dialog-btns {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}
.btn {
  margin: 0 12rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
}
.btn-cancel {
  background: #f0f0f0;
  color: #666;
}